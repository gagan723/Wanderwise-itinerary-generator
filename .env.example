NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
MONGO=your-mongodb-uri

# Browser key: restrict it to Maps JavaScript API and your web domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-api-key

# Optional production Map ID for Advanced Markers and cloud styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-map-id

# Server key: restrict it to Places API (New) and Routes API.
# Restrict by server IP when your hosting provides stable outbound addresses.
GOOGLE_MAPS_SERVER_API_KEY=your-server-api-key

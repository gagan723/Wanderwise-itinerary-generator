NEXTAUTH_SECRET=your-nextauth-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GEMINI_API_KEY=your-gemini-api-key
MONGO=your-mongodb-uri

# Browser key: restrict it to Maps JavaScript API and your web domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-api-key

# Optional production Map ID for Advanced Markers and cloud styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-map-id

# Server key: restrict it to the Geocoding API and Routes API.
GOOGLE_MAPS_SERVER_API_KEY=your-server-api-key
